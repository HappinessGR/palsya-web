NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# From Clerk dashboard -> Webhooks -> your endpoint's signing secret.
# Used by app/api/webhooks/clerk/route.ts to sync users -> local DB.
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue
# Both land on /auth/continue, which assigns/checks the role and routes each
# role to its dashboard (patients: /sign-up/starting-trial -> trial -> /onboarding).
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/continue

# Neon Postgres connection string, used by drizzle-orm/neon-http (src/db) and drizzle-kit
DATABASE_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the three plans in app/lib/content.ts (public: read client-side on /sign-up and /pricing)
NEXT_PUBLIC_STRIPE_PRICE_APP=
NEXT_PUBLIC_STRIPE_PRICE_GUIDED=
NEXT_PUBLIC_STRIPE_PRICE_SUPPORTED=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (password reset, password-changed notice, staff invitations) — lib/email/mailer.ts.
# Leave SMTP_HOST empty in development: emails (with their links) are printed to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Palsya <no-reply@example.com>"
SUPPORT_EMAIL=support@example.com
# Optional: also write every email as JSON into this folder (used by scripts/role-tests.mjs).
MAIL_OUTBOX_DIR=
